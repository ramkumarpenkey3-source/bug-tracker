pipeline {
    agent any

    stages {
        stage('Unit Tests -- Backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }

            environment {
                GOCACHE = "${WORKSPACE}/.cache/go-build"
                GOPATH = "${WORKSPACE}/.go"
            }

            steps {
                dir('bugtracker-backend') {
                    sh 'mkdir -p "$GOCACHE" "$GOPATH"'
                    sh 'go test -v ./...'
                }
            }
        }

        stage('Unit Tests -- Forntend') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }

            steps {
                dir('bugtracker-frontend) {
                    sh '''
                      npm ci
                      npm test
                    '''
                }
            }

        }


    }
}